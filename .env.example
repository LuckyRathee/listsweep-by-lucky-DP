# Copy to .env (chmod 600) and fill in. Never commit .env.

# The first admin account. It is created on startup only if it does not exist yet, so a password
# you change later in the app is never overwritten. After the first start you can delete the password line.
EMAIL_VERIFIER_ADMIN_EMAIL=
EMAIL_VERIFIER_ADMIN_PASSWORD=

# Optional: a server-wide API key (32+ characters) that always works for agents and scripts.
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
EMAIL_VERIFIER_API_KEY=

EMAIL_VERIFIER_RATE_LIMIT_PER_MINUTE=120

# Mailbox (SMTP) checks. Leave these out until outbound port 25 is allowed from your server.
# The HELO name must resolve to the server's IP, and MAIL_FROM must be on that same domain.
# VERIFIER_SMTP_ENABLED=true
# VERIFIER_HELO_DOMAIN=probe.example.com
# VERIFIER_MAIL_FROM=probe@probe.example.com

# Listen on all interfaces instead of loopback. Only do this behind a firewall that restricts port 8080.
# VERIFIER_BIND=0.0.0.0

# HTTPS in front of the app (Caddy). A domain gets a trusted certificate (port 80 must be open to the internet);
# a bare IP gets a certificate from Caddy's own authority (browsers warn until you trust it).
# COMPOSE_PROFILES=https
# VERIFIER_DOMAIN=listsweep.example.com
# VERIFIER_HTTPS_HOST=203.0.113.10
# VERIFIER_TRUSTED_PROXY=*
