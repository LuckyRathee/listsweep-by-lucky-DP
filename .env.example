# Copy to .env (chmod 600) and fill in. Never commit .env.

# The first admin account. It is created on startup only if it does not exist yet, so a password
# you change later in the app is never overwritten. After the first start you can delete the password line.
EMAIL_VERIFIER_ADMIN_EMAIL=
EMAIL_VERIFIER_ADMIN_PASSWORD=

# Optional: a server-wide API key (32+ characters) that always works for agents and scripts.
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
EMAIL_VERIFIER_API_KEY=

EMAIL_VERIFIER_RATE_LIMIT_PER_MINUTE=120
