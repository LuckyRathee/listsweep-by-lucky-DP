# HTTPS in front of the app. Used only when COMPOSE_PROFILES=https is set in .env.
#
# VERIFIER_DOMAIN       a domain name pointing at this server: Caddy gets a trusted Let's Encrypt
#                       certificate for it. Port 80 must be reachable from the internet for that.
# VERIFIER_HTTPS_HOST   optional, the server's bare IP address: served with a certificate signed by
#                       Caddy's own local authority, so browsers warn until you trust its root.
{
	default_sni {$VERIFIER_HTTPS_HOST:127.0.0.1}
}

{$VERIFIER_DOMAIN:localhost} {
	reverse_proxy api:8080
}

https://{$VERIFIER_HTTPS_HOST:127.0.0.1} {
	tls internal
	reverse_proxy api:8080
}
